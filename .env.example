# Copy this file to .env and fill in the values for your deployment.
APP_ENV=development
DATABASE_URL=
TELEGRAM_SECRET=change-me
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
APP_PUBLIC_URL=https://your-service.onrender.com
OWNER_TELEGRAM_CHAT_ID=
OWNER_TELEGRAM_USER_ID=
OWNER_DISPLAY_NAME=Administrator
TEAM_ROSTER=[{"key":"owner","display_name":"Administrator"},{"key":"alex","display_name":"Alex"}]
LINK_CODES={"replace-with-admin-discord-code":{"key":"owner","display_name":"Administrator"},"replace-with-alex-discord-code":{"key":"alex","display_name":"Alex"}}
DISCORD_PUBLIC_KEY=replace-with-discord-public-key
DISCORD_APPLICATION_ID=replace-with-discord-app-id
DISCORD_BOT_TOKEN=replace-with-discord-bot-token
DISCORD_TASK_CHANNEL_ID=
INTERNAL_SECRET=change-me
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=replace-with-verified-model
